<mxfile host="drawio" version="24.7.17"><diagram id="flow" name="Flow"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Herdr Team: from task to verified plan&lt;/b&gt;&lt;br&gt;&lt;i&gt;Turn the stochastic into the deterministic&lt;/i&gt;" style="text;html=1;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="c3" value="User gives a task to the &lt;b&gt;master&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="240" height="50" as="geometry"/></mxCell><mxCell id="c4" value="knowledge/ wiki&lt;br&gt;exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="200" height="90" as="geometry"/></mxCell><mxCell id="c5" value="Create OKF 0.2 wiki&lt;br&gt;knowledge/{AGENTS.md, index.md, log.md, raw/, wiki/}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="165" width="300" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;herdr-grill&lt;/b&gt; interview (own tab)&lt;br&gt;plans start · note (one full checkpoint per round) · resume (latest only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="300" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;plans propose SESSION&lt;/b&gt;&lt;br&gt;rejects plans without &lt;code&gt;- [wiki] knowledge/… or docs/wiki/…&lt;/code&gt; on existing pages&lt;br&gt;or a criterion without &lt;code&gt;Verify:&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="300" height="70" as="geometry"/></mxCell><mxCell id="c8" value="User approves the exact text&lt;br&gt;&lt;b&gt;plans approve PLAN&lt;/b&gt;&lt;br&gt;newest plan only · approver = master terminal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="300" height="70" as="geometry"/></mxCell><mxCell id="c9" value="Implementers, one tab each&lt;br&gt;&lt;b&gt;plans show PLAN&lt;/b&gt; (only command)&lt;br&gt;update code &lt;b&gt;and&lt;/b&gt; wiki together" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Master verifies each criterion&lt;br&gt;&lt;b&gt;plans check PLAN R1..Rn | integration pass|fail&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="300" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Wiki review loop&lt;/b&gt;: 2 fresh reviewer tabs, independent&lt;br&gt;each: &lt;b&gt;plans check PLAN wiki pass|fail&lt;/b&gt;&lt;br&gt;stored with reviewer terminal + working-tree SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="670" width="330" height="80" as="geometry"/></mxCell><mxCell id="c12" value="2 distinct passes,&lt;br&gt;0 fails, on the&lt;br&gt;current tree?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="500" y="790" width="210" height="110" as="geometry"/></mxCell><mxCell id="c13" value="Owner fixes code (or wiki, if the plan changed intent)&lt;br&gt;close reviewers, open fresh ones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="680" width="260" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;plans finish PLAN&lt;/b&gt;&lt;br&gt;re-hashes the tree · all criteria latest = pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="950" width="270" height="60" as="geometry"/></mxCell><mxCell id="c15" value="Plan &lt;b&gt;verified&lt;/b&gt;: code and wiki agree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="955" width="250" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;herdr.sqlite3&lt;/b&gt;&lt;br&gt;one per repo&lt;br&gt;outside checkout" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1130" y="330" width="160" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;knowledge/ or docs/wiki/&lt;/b&gt;&lt;br&gt;source of truth" style="shape=folder;whiteSpace=wrap;html=1;tabWidth=60;tabHeight=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1130" y="170" width="160" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Clean context&lt;/b&gt;&lt;br&gt;• no command replays history&lt;br&gt;• list: id, title, plan, status&lt;br&gt;• resume: latest checkpoint&lt;br&gt;• status: results, no evidence&lt;br&gt;• each agent sees one plan" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="770" width="220" height="120" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="no" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="yes" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="255"/><mxPoint x="210" y="255"/></Array></mxGeometry></mxCell><mxCell id="c27" value="" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="yes" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="no" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="845"/></Array></mxGeometry></mxCell><mxCell id="c32" value="loop" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c13" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="640"/><mxPoint x="605" y="640"/></Array></mxGeometry></mxCell><mxCell id="c33" value="refused if the snapshot changed" style="endArrow=block;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c14" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="980"/><mxPoint x="400" y="710"/></Array></mxGeometry></mxCell><mxCell id="c34" value="plans" style="endArrow=open;dashed=1;html=1;strokeColor=#888888;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="checks" style="endArrow=open;dashed=1;html=1;strokeColor=#888888;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c11" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="710"/></Array></mxGeometry></mxCell><mxCell id="c36" value="reads + updates" style="endArrow=open;dashed=1;html=1;strokeColor=#888888;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="615"/><mxPoint x="1000" y="205"/></Array></mxGeometry></mxCell><mxCell id="c37" value="built on" style="endArrow=open;dashed=1;html=1;strokeColor=#888888;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="315"/><mxPoint x="400" y="140"/><mxPoint x="1210" y="140"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="database-schema" name="Database schema"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c38" value="&lt;b&gt;herdr.sqlite3&lt;/b&gt; · STRICT tables · WAL · foreign_keys=ON · user_version migrations · application_id 'HRDR' · timestamps UTC ISO 8601" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c39" value="sessions" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;collapsible=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="250" height="102" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;id&lt;/b&gt; INTEGER PK&lt;br&gt;title TEXT NOT NULL ≠ ''&lt;br&gt;created TEXT" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="c39"><mxGeometry y="28" width="250" height="74" as="geometry"/></mxCell><mxCell id="c41" value="notes &lt;i&gt;(checkpoints)&lt;/i&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;collapsible=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="280" height="146" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;id&lt;/b&gt; INTEGER PK&lt;br&gt;session → sessions.id CASCADE&lt;br&gt;body TEXT NOT NULL ≠ ''&lt;br&gt;created TEXT&lt;br&gt;&lt;i&gt;index (session, id)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="c41"><mxGeometry y="28" width="280" height="118" as="geometry"/></mxCell><mxCell id="c43" value="plans" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;collapsible=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="300" height="212" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;id&lt;/b&gt; INTEGER PK&lt;br&gt;session → sessions.id CASCADE&lt;br&gt;body TEXT NOT NULL &lt;i&gt;(immutable)&lt;/i&gt;&lt;br&gt;created TEXT&lt;br&gt;approved TEXT&lt;br&gt;approver TEXT &lt;i&gt;(master terminal)&lt;/i&gt;&lt;br&gt;verified TEXT &lt;i&gt;(needs approved)&lt;/i&gt;&lt;br&gt;&lt;i&gt;index (session, id)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="c43"><mxGeometry y="28" width="300" height="184" as="geometry"/></mxCell><mxCell id="c45" value="checks &lt;i&gt;(append-only)&lt;/i&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;collapsible=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="360" height="234" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;id&lt;/b&gt; INTEGER PK&lt;br&gt;plan → plans.id CASCADE&lt;br&gt;criterion TEXT &lt;i&gt;(R&amp;lt;n&amp;gt; | integration | wiki)&lt;/i&gt;&lt;br&gt;result TEXT &lt;i&gt;pass | fail&lt;/i&gt;&lt;br&gt;evidence TEXT NOT NULL ≠ ''&lt;br&gt;reviewer TEXT &lt;i&gt;(HC_TERMINAL_ID)&lt;/i&gt;&lt;br&gt;snapshot TEXT &lt;i&gt;(tree SHA-256, required for wiki)&lt;/i&gt;&lt;br&gt;created TEXT&lt;br&gt;&lt;i&gt;index (plan, criterion, id)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="c45"><mxGeometry y="28" width="360" height="206" as="geometry"/></mxCell><mxCell id="c47" value="plan_status &lt;i&gt;(view)&lt;/i&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;collapsible=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="380" width="300" height="80" as="geometry"/></mxCell><mxCell id="c48" value="id, session, status&lt;br&gt;draft · approved · superseded · verified" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="c47"><mxGeometry y="28" width="300" height="52" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Triggers&lt;/b&gt;&lt;br&gt;plans_text_is_immutable: no UPDATE of id, session, body, created&lt;br&gt;checks_are_append_only, checks_are_never_deleted: no UPDATE or DELETE on checks&lt;br&gt;plans_are_never_deleted · approval_is_final · verification_is_final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="380" width="360" height="80" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Rules enforced by the helper&lt;/b&gt;&lt;br&gt;• propose: ≥1 &lt;code&gt;- [wiki] knowledge/…&lt;/code&gt;, all existing, unique R&amp;lt;n&amp;gt; criteria each with &lt;code&gt;Verify:&lt;/code&gt;&lt;br&gt;• approve: newest plan of its session only&lt;br&gt;• check: only the active approved plan&lt;br&gt;• wiki check: reviewer ≠ approver, stores current snapshot&lt;br&gt;• finish: latest R&amp;lt;n&amp;gt; + integration = pass, and ≥2 distinct wiki passes, 0 fails on the current snapshot" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="700" height="130" as="geometry"/></mxCell><mxCell id="c51" value="1 : n" style="endArrow=ERmany;startArrow=ERone;html=1;endFill=0;startFill=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c39" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="1 : n" style="endArrow=ERmany;startArrow=ERone;html=1;endFill=0;startFill=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c39" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="1 : n" style="endArrow=ERmany;startArrow=ERone;html=1;endFill=0;startFill=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c43" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="derived from" style="endArrow=open;dashed=1;html=1;strokeColor=#888888;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c47" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
