#!/bin/sh
skill=$(cd "${0%/*}" && pwd -P) || exit 1
for bin in "$skill/bin/herdr-plans" "$skill/../../target/debug/herdr-plans" "$skill/../../target/release/herdr-plans"; do
	[ -x "$bin" ] && exec "$bin" "$@"
done
echo "herdr-plans is missing. Use a package for your platform or run 'make build' in the source checkout." >&2
exit 1
